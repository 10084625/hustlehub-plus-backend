# HustleHub+ API - Environment Configuration


# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/hustlehub

# JSON Web Token (REQUIRED - the API will not start without it)
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_ISSUER=hustlehub-plus-api
JWT_AUDIENCE=hustlehub-plus-client

# Ledger signing secret (REQUIRED, Part 3). Signs every transaction record so
# that any change made directly in the database can be detected.
# Must be different from JWT_SECRET. Generate it the same way.
LEDGER_HMAC_SECRET=

# Password hashing
BCRYPT_SALT_ROUNDS=12

# HTTPS / SSL
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem

# CORS (comma separated list of allowed frontend origins)
CORS_ORIGIN=https://localhost:3000

# Rate limiting (requests per window). Defaults are safe; only change for testing.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MIN=15
RATE_LIMIT_BOOKING_MAX=10
RATE_LIMIT_BOOKING_WINDOW_MIN=10
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MIN=15

# Account lockout (Part 3): failed sign-ins allowed per email before a lock,
# and how long the lock lasts.
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Logging (Part 3)
# LOG_LEVEL: error | warn | info | http | debug
LOG_LEVEL=debug
LOG_DIR=./logs
LOG_TO_FILE=true
# Cloud logging with Azure Application Insights (see README section 13.4).
# Paste the resource's "Connection String" from its Overview page in the
# Azure portal. Leave empty to log locally only.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# How many days security events are kept in the audit_logs collection
AUDIT_RETENTION_DAYS=90

# Admin seed account (used only by "npm run seed:admin")
ADMIN_USERNAME=platform_admin
ADMIN_EMAIL=admin@hustlehub.local
# Local development only - will be changed for deployed environment.
ADMIN_PASSWORD=ChangeMe!Admin2026
# Create/update the admin automatically when the API starts (used by Docker)
SEED_ADMIN_ON_START=false
