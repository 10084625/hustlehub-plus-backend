# Docker Compose settings (copy to .env in the project root).
# These are only used by "docker compose". For running the API without
# Docker, use api/.env instead (see api/.env.example).
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use letters and numbers only for the Mongo password (it goes inside a URL).

JWT_SECRET=
LEDGER_HMAC_SECRET=

MONGO_ROOT_USERNAME=hustlehub
MONGO_ROOT_PASSWORD=

ADMIN_USERNAME=platform_admin
ADMIN_EMAIL=admin@hustlehub.local
ADMIN_PASSWORD=

# Cloud logging: Azure Application Insights connection string
# (Azure portal > your Application Insights resource > Overview > Connection String)
# See README section 13.4. Leave empty to log locally only.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# error | warn | info | http | debug
LOG_LEVEL=http
