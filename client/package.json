{
  "name": "hustlehub-plus-client",
  "version": "3.0.0",
  "private": true,
  "description": "React frontend for HustleHub+ (Part 3: DevSecOps, monitoring and finalisation).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:report": "vitest run --reporter=verbose --reporter=junit --outputFile.junit=../docs/evidence/frontend-test-results.xml",
    "lint": "eslint .",
    "lint:report": "eslint . -f json -o ../docs/evidence/static-analysis/eslint-client.json"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.1.0",
    "@fontsource/public-sans": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
